# Copie este archivo como .env y complete los valores. NO lo suba a GitHub.
PP_ADMIN_USER=admin
# Mínimo 8 caracteres con letras y números. Si lo deja vacío se genera una y se muestra en `docker compose logs app`.
PP_ADMIN_PASSWORD=
# Clave de sesión: genere una con  python -c "import secrets;print(secrets.token_hex(32))"
PP_SECRET_KEY=
# 1 sólo si accede por HTTPS (detrás de un proxy con certificado). Con http:// debe ser 0 o no podrá iniciar sesión.
PP_HTTPS=0
PP_PORT=8000
# 1 carga datos ficticios en la primera ejecución (no usar en producción)
PP_DEMO=0
